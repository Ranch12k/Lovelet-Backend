# Django Settings
DEBUG=True
SECRET_KEY=lovelink-super-secret-key-change-in-production-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for instant local dev if PG is not set)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in production:
# DATABASE_URL=postgres://lovelink_user:password@localhost:5432/lovelink_db

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Email Delivery (Console backend enabled for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@lovelink.app
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="LoveLink Notifications <notifications@lovelink.app>"

# Celery & Redis (Optional / Graceful In-Memory fallback for local dev)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Quotas
MAX_STORAGE_PER_USER_MB=50
MAX_UPLOAD_SIZE_MB=5

# Public App Base URL for Shareable Links
PUBLIC_APP_URL=http://localhost:5173
